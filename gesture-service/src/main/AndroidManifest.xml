<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.example.gesturehost.permission.BIND_GESTURE_SERVICE"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.rayneo.xr.runtime" />
    </queries>

    <application>
        <service
            android:name=".GestureRecognitionService"
            android:enabled="true"
            android:exported="true"
            android:permission="com.example.gesturehost.permission.BIND_GESTURE_SERVICE"
            android:process=":gesture_engine" />
    </application>
</manifest>
